# Copy this file to .env and fill in the two keys. Never commit .env.

# Claude API key from the Claude Console, with a few dollars of credit.
ANTHROPIC_API_KEY=

# Fine-grained GitHub token: repository access "Only select repositories" -> your test repo,
# permission "Issues: Read and write".
GITHUB_TOKEN=

# Optional settings.
CLAUDE_MODEL=claude-opus-5-5
POLL_SECONDS=10
